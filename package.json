{
  "name": "kova",
  "version": "0.2.0",
  "private": true,
  "description": "Offline-first local AI coding agent for VS Code",
  "type": "module",
  "workspaces": [
    "packages/*",
    "webview"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/core/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "smoke:ollama": "node scripts/smoke-ollama.mjs",
    "smoke:vscode": "node scripts/smoke-vscode.mjs",
    "smoke:ers": "node scripts/smoke-ers.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:vsix": "node scripts/smoke-vscode.mjs --vsix"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.138.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "license": "MIT"
}
