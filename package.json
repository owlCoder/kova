{
  "name": "kova",
  "version": "0.6.0",
  "private": true,
  "description": "Local-first AI coding workspace for desktop and VS Code",
  "type": "module",
  "workspaces": [
    "packages/*",
    "webview"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/core/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "smoke:ollama": "node scripts/smoke-ollama.mjs",
    "smoke:vscode": "node scripts/smoke-vscode.mjs",
    "smoke:ers": "node scripts/smoke-ers.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:vsix": "node scripts/smoke-vscode.mjs --vsix",
    "desktop:build": "node scripts/desktop/build.mjs",
    "desktop:dev": "node scripts/desktop/dev.mjs",
    "desktop:start": "electron dist/desktop",
    "desktop:package": "npm run desktop:build && electron-builder --config electron-builder.yml --publish never",
    "desktop:verify": "node scripts/desktop/verify.mjs",
    "desktop:smoke": "node scripts/desktop/smoke.mjs --verify"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "overrides": {
    "@electron/get": "5.1.0",
    "source-map-js": "^1.2.2"
  }
}
