{
  "name": "kova-local",
  "displayName": "Kova — AI Coding Workspace",
  "description": "Modern local-first coding workspace with guided setup, Ollama, DeepSeek and configurable AI providers",
  "version": "0.6.0",
  "publisher": "owlcoder",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Machine Learning", "Other"],
  "repository": {
    "type": "git",
    "url": "https://github.com/owlCoder/kova.git"
  },
  "homepage": "https://github.com/owlCoder/kova#readme",
  "bugs": {
    "url": "https://github.com/owlCoder/kova/issues"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onCommand:kova.open",
    "onCommand:kova.openInEditor",
    "onCommand:kova.newConversation",
    "onCommand:kova.settings",
    "onCommand:kova.setProviderApiKey",
    "onCommand:kova.clearProviderApiKey",
    "onView:kova.chat",
    "onCommand:kova.setup"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kova",
          "title": "Kova",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "kova": [
        {
          "type": "webview",
          "id": "kova.chat",
          "name": "Kova"
        }
      ]
    },
    "commands": [
      {
        "command": "kova.open",
        "title": "Kova: Open Chat"
      },
      {
        "command": "kova.openInEditor",
        "title": "Kova: Open Chat in Editor"
      },
      {
        "command": "kova.newConversation",
        "title": "Kova: New Conversation"
      },
      {
        "command": "kova.settings",
        "title": "Kova: Open Settings"
      },
      {
        "command": "kova.setProviderApiKey",
        "title": "Kova: Set Provider API Key"
      },
      {
        "command": "kova.clearProviderApiKey",
        "title": "Kova: Clear Provider API Key"
      },
      {
        "command": "kova.setup",
        "title": "Kova: Set Up AI Provider"
      }
    ],
    "configuration": {
      "title": "Kova",
      "properties": {
        "kova.provider": {
          "type": "string",
          "enum": ["ollama", "deepseek", "openaiCompatible"],
          "default": "ollama",
          "description": "LLM provider. Ollama remains the local-first default."
        },
        "kova.ollama.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama endpoint. Defaults to the local runtime."
        },
        "kova.ollama.model": {
          "type": "string",
          "default": "qwen3:4b"
        },
        "kova.ollama.think": {
          "type": "boolean",
          "default": false,
          "description": "Stream model thinking separately; it is never saved in conversation history."
        },
        "kova.ollama.keepAliveSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 0,
          "maximum": 3600
        },
        "kova.deepseek.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek OpenAI-compatible API endpoint."
        },
        "kova.deepseek.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "Default DeepSeek model ID."
        },
        "kova.deepseek.think": {
          "type": "boolean",
          "default": false,
          "description": "Enable DeepSeek thinking mode. Reasoning is streamed transiently and is not saved in conversation history."
        },
        "kova.openaiCompatible.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000/v1",
          "description": "Base URL for an OpenAI Chat Completions-compatible endpoint."
        },
        "kova.openaiCompatible.model": {
          "type": "string",
          "default": "",
          "description": "Preferred model ID. Leave empty to use the first model returned by /models."
        },
        "kova.openaiCompatible.supportsTools": {
          "type": "boolean",
          "default": true,
          "description": "Whether the configured endpoint/model supports OpenAI-style function tool calls."
        },
        "kova.context.maxTokens": {
          "type": "integer",
          "default": 32768,
          "minimum": 512,
          "maximum": 1048576
        },
        "kova.context.reservedOutputTokens": {
          "type": "integer",
          "default": 4096,
          "minimum": 128,
          "maximum": 393216
        },
        "kova.context.safetyMarginRatio": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 0.5
        },
        "kova.commands.allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "git status",
            "git diff",
            "git log",
            "dotnet build",
            "dotnet test",
            "npm test"
          ],
          "description": "Exact executable/argv commands eligible for Auto. Compound shell commands never match."
        },
        "kova.ers.guardrailsProject": {
          "type": "string",
          "default": "",
          "description": "Optional workspace-relative ERS Guardrails csproj. Build it in Release first. Evaluated as a separate final guardrail, fail-closed."
        },
        "kova.openaiCompatible.name": {
          "type": "string",
          "default": "OpenAI-compatible provider",
          "maxLength": 100,
          "description": "Display name for the custom AI provider. Configure it with Kova: Set Up AI Provider."
        },
        "kova.openaiCompatible.discoverModels": {
          "type": "boolean",
          "default": true,
          "description": "Fetch /models. Disable to use the configured model ID with endpoints that do not expose a model list. Manual mode checks the connection on the first prompt."
        },
        "kova.ui.language": {
          "type": "string",
          "enum": ["en", "sr", "de"],
          "enumDescriptions": ["English", "Srpski (latinica)", "Deutsch"],
          "default": "en",
          "description": "Interface language. Code, model responses and conversation content are not translated."
        },
        "kova.ui.textSize": {
          "type": "string",
          "enum": ["standard", "large", "larger"],
          "enumDescriptions": ["Comfortable", "Large", "Extra large"],
          "default": "standard",
          "description": "Text size for the Kova interface."
        }
      }
    }
  },
  "icon": "media/logo.png",
  "keywords": [
    "ai agent",
    "coding assistant",
    "ollama",
    "qwen",
    "qwen3",
    "deepseek",
    "openai compatible",
    "local ai",
    "offline",
    "mcp"
  ],
  "galleryBanner": {
    "color": "#17191d",
    "theme": "dark"
  },
  "extensionKind": ["workspace"],
  "files": [
    "extension.cjs",
    "extension.cjs.LEGAL.txt",
    "media/**",
    "webview/assets/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "SETUP.md",
    "USAGE.md"
  ]
}
