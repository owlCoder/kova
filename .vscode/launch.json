{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Kova Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/dist/extension"],
      "preLaunchTask": "Build Kova",
      "outFiles": [
        "${workspaceFolder}/dist/extension/**/*.js",
        "${workspaceFolder}/dist/extension/**/*.cjs"
      ]
    }
  ]
}
